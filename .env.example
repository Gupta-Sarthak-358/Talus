# Talus environment variables — copy to .env and fill in locally.
# Never commit .env.

# --- Application ---
APP_NAME=Talus
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Database (prototype defaults to SQLite; Postgres+PostGIS for GIS work) ---
DATABASE_URL=sqlite:///./talus.db
# DATABASE_URL=postgresql://user:password@localhost:5432/talus

# --- Synthetic data generation ---
SYNTHETIC_SEED=42
SYNTHETIC_VERSION=1.0

# --- Risk model ---
MODEL_PATH=ml/models/risk_model_v1.pkl
MODEL_RISK_THRESHOLD_CRITICAL=80

# --- CORS (comma-separated origins for the React dev server) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Demo / frontend ---
FRONTEND_PORT=5173