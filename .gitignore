# ── Environment / Secrets ─────────────────────────────────────────────
.env
.env.local
*.env
*.pem
*.key
*.p12

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.python-version
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# ── Node / Frontend ───────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
dist/
build/
.vite/

# ── IDE / OS ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Data: never commit large datasets ─────────────────────────────────
# Raw/historical/sensor data should live outside git (LFS, Releases,
# Drive, or Hugging Face). Keep only small samples or schemas in-repo.
data/raw/*
data/processed/*
data/synthetic/*
!data/raw/imd/
!data/raw/dem/
!data/raw/crack_seg/
!data/processed/rainfall/
!data/processed/imd/
!data/processed/terrain/
!data/processed/geotech/
!data/processed/blasting/
!data/processed/cracks/
!data/processed/crack_features/
!data/synthetic/v1/

# re-ignore bulk dataset files (they stay out of git)
data/raw/imd/*
data/raw/dem/*
data/raw/crack_seg/*

# whitelist only small metadata/docs/schema/sample files inside data dirs
!data/**/.gitkeep
!data/raw/**/*.md
!data/processed/**/*.md
!data/synthetic/**/*.md
!data/raw/**/*.schema.*
!data/raw/**/*.meta.json
!data/synthetic/**/metadata.json
!data/processed/**/*.sample.csv
!data/synthetic/**/*.sample.csv

# ── Models: never commit trained weights blindly ──────────────────────
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.onnx
ml/models/*.pt
ml/models/*.pth
ml/models/*.safetensors
!ml/models/**/*.md
ml/training/*.log
ml/training/runs/

# ── CV artifacts ──────────────────────────────────────────────────────
cv/runs/
cv/weights/
cv/datasets/

# ── Logs / caches ─────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.cache
wandb/
runs/

# ── Other build artifacts ─────────────────────────────────────────────
*.pyc
*.egg-info/
*_cache/
.coverage
htmlcov/
.eggs/
# backend model artifact (regenerated from frozen corpus on startup)
backend/app/_model.joblib
